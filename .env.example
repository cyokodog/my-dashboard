# カレンダーAPI設定
# CalDAV API（推奨・高速）または AppleScript（macOS専用・低速）を選択
# デフォルト: CalDAV API
# AppleScriptを使う場合: CALENDAR_API_TYPE=applescript
CALENDAR_API_TYPE=caldav

# iCloud CalDAV 認証情報（CALENDAR_API_TYPE=caldav の場合に必要）
# Apple ID（メールアドレス）
ICAL_USERNAME=your-apple-id@icloud.com

# iCloud App専用パスワード（https://appleid.apple.com で生成）
ICAL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 取得対象のカレンダー名（カンマ区切り、空の場合は全カレンダー）
ICAL_CALENDAR_NAMES=
